<style>
.notice-bs-picker {
    position: relative; z-index: 1000; width: 310px; max-width: 100%; font-family: inherit;
    margin-top: 6px; padding: 10px; background: #fff; border: 1px solid #cbd2d9;
    border-radius: 5px; box-shadow: 0 4px 14px rgba(0,0,0,.13);
}
.notice-bs-picker-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:9px; }
.notice-bs-picker-head button {
    border:1px solid #d5dbe1; background:#f5f6f7; border-radius:4px;
    width:32px; height:30px; font-size:20px; cursor:pointer;
}
.notice-bs-weekdays,.notice-bs-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:3px; text-align:center; }
.notice-bs-weekdays span { padding:5px 0; font-size:12px; font-weight:600; color:#475569; }
.notice-bs-day { border:0; border-radius:4px; padding:7px 0; background:#f3f5f7; cursor:pointer; }
.notice-bs-day:hover:not(:disabled),.notice-bs-day.selected { background:#1769aa; color:#fff; }
.notice-bs-day:disabled { color:#c2c7cc; background:#fafafa; cursor:not-allowed; }
</style>
<script>
(function () {
    const display = document.getElementById('notice-bs-date-display');
    const adInput = document.getElementById('notice-ad-date');
    const bsInput = document.getElementById('notice-bs-date');
    const picker = document.getElementById('notice-bs-picker');
    if (!display || !adInput || !bsInput || !picker) return;

    const url = @json(route('admin.notice.bs-calendar'));
    const months = ['Baisakh','Jestha','Ashadh','Shrawan','Bhadra','Ashwin','Kartik','Mangsir','Poush','Magh','Falgun','Chaitra'];
    const toNp = value => String(value).replace(/[0-9]/g, d => '०१२३४५६७८९'[d]);
    const toEn = value => String(value).replace(/[०-९]/g, d => '०१२३४५६७८९'.indexOf(d));
    let currentYear = 0, currentMonth = 0, todayYear = 0, todayMonth = 0;
    let todayDate = '', selectedAd = '';

    function showSelected(day, data) {
        adInput.value = day.date;
        bsInput.value = data.yearNe + '-' + toNp(String(data.month).padStart(2, '0')) + '-' + day.bsDate;
        display.value = toEn(day.bsDate) + ' ' + months[data.month - 1] + ' ' + toEn(data.yearNe);
        selectedAd = day.date;
        picker.style.display = 'none';
    }

    async function loadMonth(params) {
        const query = new URLSearchParams(params);
        const response = await fetch(url + '?' + query.toString(), {
            headers: {'Accept': 'application/json'},
            credentials: 'same-origin'
        });
        if (!response.ok) throw new Error('Calendar could not be loaded.');
        const data = await response.json();

        currentYear = data.year;
        currentMonth = data.month;
        todayYear = data.todayYear;
        todayMonth = data.todayMonth;
        todayDate = data.todayDate;

        document.getElementById('notice-bs-month-title').textContent =
            months[data.month - 1] + ' ' + toEn(data.yearNe);

        const container = document.getElementById('notice-bs-days');
        container.innerHTML = '';
        const firstWeekday = data.days.length ? data.days[0].weekday : 0;

        for (let i = 0; i < firstWeekday; i++) {
            const blank = document.createElement('span');
            container.appendChild(blank);
        }

        data.days.forEach(day => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'notice-bs-day';
            button.textContent = toEn(day.bsDate);
            button.disabled = day.date > todayDate;
            if (day.date === selectedAd) button.classList.add('selected');
            button.addEventListener('click', () => showSelected(day, data));
            container.appendChild(button);
        });

        document.getElementById('notice-bs-prev').disabled =
            currentYear === 2000 && currentMonth === 1;
        document.getElementById('notice-bs-next').disabled =
            currentYear > todayYear ||
            (currentYear === todayYear && currentMonth >= todayMonth);
        return data;
    }

    async function openPicker() {
        picker.style.display = 'block';
        try {
            const params = adInput.value ? {date: adInput.value} : {};
            const data = await loadMonth(params);
            const existing = data.days.find(day => day.date === adInput.value);
            if (existing) {
                display.value = toEn(existing.bsDate) + ' ' + months[data.month - 1] + ' ' + toEn(data.yearNe);
                if (!bsInput.value) {
                    bsInput.value = data.yearNe + '-' +
                        toNp(String(data.month).padStart(2, '0')) + '-' + existing.bsDate;
                }
            } else if (!adInput.value && data.days.length) {
                const today = data.days.find(day => day.date === data.todayDate);
                if (today) showSelected(today, data);
            }
        } catch (error) {
            picker.style.display = 'none';
            alert('Unable to load the Nepali calendar. Please try again.');
        }
    }

    display.addEventListener('click', openPicker);
    document.getElementById('notice-bs-prev').addEventListener('click', async () => {
        let y = currentYear, m = currentMonth - 1;
        if (m < 1) { m = 12; y--; }
        try { await loadMonth({year:y, month:m}); } catch (e) {}
    });
    document.getElementById('notice-bs-next').addEventListener('click', async () => {
        let y = currentYear, m = currentMonth + 1;
        if (m > 12) { m = 1; y++; }
        if (y > todayYear || (y === todayYear && m > todayMonth)) return;
        try { await loadMonth({year:y, month:m}); } catch (e) {}
    });

    async function initializeDateDisplay() {
        try {
            const data = await loadMonth(adInput.value ? {date: adInput.value} : {});
            const selected = adInput.value
                ? data.days.find(day => day.date === adInput.value)
                : data.days.find(day => day.date === data.todayDate);

            if (selected) {
                adInput.value = selected.date;
                bsInput.value = data.yearNe + '-' +
                    toNp(String(data.month).padStart(2, '0')) + '-' + selected.bsDate;
                display.value = toEn(selected.bsDate) + ' ' +
                    months[data.month - 1] + ' ' + toEn(data.yearNe);
                selectedAd = selected.date;
            }

            picker.style.display =
                picker.dataset.autoOpen === 'true' ? 'block' : 'none';
        } catch (error) {
            picker.style.display = 'none';
            console.error('Nepali date initialization failed:', error);
        }
    }

    initializeDateDisplay();
})();
</script>
