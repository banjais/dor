    /**
     * Validate matching AD and BS dates.
     * Past and future dates are both permitted for Publication.
     */
    private function validatePublicationPublishedDate(Request $request, $validator): void
    {
        $adDate = trim((string) $request->input('published_date', ''));
        $bsDate = trim((string) $request->input('published_date_bs', ''));

        try {
            $date = \DateTime::createFromFormat(
                '!Y-m-d',
                $adDate,
                new \DateTimeZone('Asia/Kathmandu')
            );

            if (!$date || $date->format('Y-m-d') !== $adDate) {
                $validator->errors()->add('published_date_bs', 'Please select a valid Nepali date.');
                return;
            }

            $result = \Calendar::eng_to_nep(
                (int) $date->format('Y'),
                (int) $date->format('m'),
                (int) $date->format('d')
            );

            if (!($result['type'] ?? false)) {
                $validator->errors()->add('published_date_bs', 'Date is outside the supported calendar range.');
                return;
            }

            $expectedBs = $result['nepali_year'] . '-' .
                $result['nepali_month'] . '-' . $result['nepali_date'];

            if ($bsDate !== $expectedBs) {
                $validator->errors()->add('published_date_bs', 'The selected Nepali date does not match.');
            }
        } catch (\Throwable $e) {
            $validator->errors()->add('published_date_bs', 'Please select a valid Nepali date.');
        }
    }
